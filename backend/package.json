{
  "name": "keiri-kaikei-backend",
  "version": "0.1.0",
  "description": "経理・会計オールインワンAIアプリケーション バックエンド (NestJS + TypeScript + node-postgres, ORM不使用・生SQL駆動)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "generate:types": "openapi-typescript ../docs/openapi.yaml -o src/types/api.generated.ts",
    "db:apply-schema": "psql \"$DATABASE_URL\" -f ../sql/001_initial_schema_all_in_one.sql",
    "db:migrate": "node ../scripts/db-migrate.js",
    "db:verify-schema": "python3 ../scripts/verify_schema.py --dsn \"$DATABASE_URL\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.5",
    "dotenv": "^17.4.2",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "pdf-lib": "^1.17.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
