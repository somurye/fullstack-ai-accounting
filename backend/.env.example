# サーバー
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL接続 (DATABASE_URL優先。未設定時は個別のPG*環境変数を使用)
DATABASE_URL=postgresql://app_runtime:change_me_in_production@localhost:5432/keiri_kaikei
PGHOST=localhost
PGPORT=5432
PGUSER=app_runtime
PGPASSWORD=change_me_in_production
PGDATABASE=keiri_kaikei
PG_POOL_MAX=20

# JWT (本番環境では必ずシークレットマネージャ経由で注入すること)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# 外部連携APIキー等の暗号化マスター鍵 (base64エンコード済み32バイト鍵。本番環境では必ずシークレットマネージャ経由で注入すること)
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=change-me-in-production
